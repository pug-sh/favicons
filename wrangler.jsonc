{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "favicon",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.ts",
  "routes": [
    { "pattern": "favicons.pug.sh", "custom_domain": true }
  ],
  "r2_buckets": [
    {
      "binding": "FAVICONS",
      "bucket_name": "favicons"
    }
  ],
  "vars": {
    "CANONICAL_ORIGIN": "https://favicons.pug.sh"
  }
}